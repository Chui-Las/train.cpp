#version 450
// train.cpp - Vulkan 交叉熵损失 kernel（cross_entropy_loss；单 workgroup，输出 1 元素）
// 与 ggml/CPU 一致：loss = -1/nr * Σ_row Σ_c target * (logits - max - log(Σexp(logits-max)))
// 行 = (i1,i2,i3)，每线程处理若干行（行内串行，规模优先正确性）；最后 workgroup 树形归约
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint  nc;      // ne0（类别数）
    uint  nr;      // ne1*ne2*ne3（行数）
    uint  ne1;
    uint  ne2;
    uint  nb_a[4]; // logits 步长（元素单位）
    uint  nb_b[4]; // target 步长（元素单位）
    uint  base_a;
    uint  base_b;
    uint  base_d;
    float inv_nr;  // 1/nr
} pc;

layout(std430, binding = 0) readonly buffer A { float data_a[]; };
layout(std430, binding = 1) readonly buffer B { float data_b[]; };
layout(std430, binding = 2) writeonly buffer D { float data_d[]; };

shared float sdata[256];

void main() {
    const uint tid = gl_LocalInvocationID.x;

    float acc = 0.0;
    for (uint row = tid; row < pc.nr; row += 256u) {
        const uint i1 = row % pc.ne1;
        const uint t  = row / pc.ne1;
        const uint i2 = t % pc.ne2;
        const uint i3 = t / pc.ne2;

        const uint off_a = pc.base_a + i1 * pc.nb_a[1] + i2 * pc.nb_a[2] + i3 * pc.nb_a[3];
        const uint off_b = pc.base_b + i1 * pc.nb_b[1] + i2 * pc.nb_b[2] + i3 * pc.nb_b[3];

        // 数值稳定 log_softmax
        float mx = -3.402823466e+38;
        for (uint k = 0u; k < pc.nc; ++k) {
            mx = max(mx, data_a[off_a + k * pc.nb_a[0]]);
        }
        float se = 0.0;
        for (uint k = 0u; k < pc.nc; ++k) {
            se += exp(data_a[off_a + k * pc.nb_a[0]] - mx);
        }
        const float lse = mx + log(se);

        float s = 0.0;
        for (uint k = 0u; k < pc.nc; ++k) {
            s += data_b[off_b + k * pc.nb_b[0]] * (data_a[off_a + k * pc.nb_a[0]] - lse);
        }
        acc += s;
    }

    sdata[tid] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (tid < s) {
            sdata[tid] += sdata[tid + s];
        }
        barrier();
    }
    if (tid == 0u) {
        data_d[pc.base_d] = -sdata[0] * pc.inv_nr;
    }
}
