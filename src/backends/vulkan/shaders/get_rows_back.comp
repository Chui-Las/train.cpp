#version 450
// train.cpp - Vulkan get_rows 反向 kernel（scatter-add 回表）
// 每个 (i11, i12, 表行) 由独立 workgroup 负责：先清零该行，再扫描索引条目累加梯度行
// 注：为无原子实现（确定性），复杂度 O(n_vocab * nr)；性能优化留待后续
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne0;
    uint n_vocab;
    uint nr;
    uint ni1;
    uint ni2;
    uint nb_g[4];  // 梯度 [ne0, nr, ni1, ni2]
    uint nb_d[4];  // 表梯度 [ne0, n_vocab, ni1, ni2]
    uint nb_i[3];  // 索引 [nr, ni1, ni2]
    uint base_g;
    uint base_d;
    uint base_i;
} pc;

layout(std430, binding = 0) readonly buffer G { float data_g[]; };
layout(std430, binding = 1) buffer D { float data_d[]; };
layout(std430, binding = 2) readonly buffer I { int data_i[]; };
// 设备端错误标志：errors[2]=3（get_rows_back）
layout(std430, binding = 3) buffer ERR { uint errors[]; };

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint planes = pc.ni1 * pc.ni2;
    const uint total = planes * pc.n_vocab;

    for (uint st = gl_WorkGroupID.x; st < total; st += gl_NumWorkGroups.x) {
        const uint r1  = st % pc.n_vocab;
        const uint pl  = st / pc.n_vocab;
        const uint i11 = pl % pc.ni1;
        const uint i12 = pl / pc.ni1;

        const uint off_d = pc.base_d + r1 * pc.nb_d[1] + i11 * pc.nb_d[2] + i12 * pc.nb_d[3];

        // 清零该表行的梯度
        for (uint i0 = tid; i0 < pc.ne0; i0 += 256u) {
            data_d[off_d + i0 * pc.nb_d[0]] = 0.0;
        }
        barrier();

        // 扫描索引行并累加
        for (uint i10 = 0; i10 < pc.nr; ++i10) {
            const int row =
                data_i[pc.base_i + i10 * pc.nb_i[0] + i11 * pc.nb_i[1] + i12 * pc.nb_i[2]];
            if (row < 0 || uint(row) >= pc.n_vocab) {
                // 索引越界：置错误标志（主机在 graph_compute 结束后中止）
                atomicOr(errors[0], 1u);
                errors[1] = uint(row);
                errors[2] = 3u;  // get_rows_back
            }
            if (uint(row) == r1) {
                const uint off_g =
                    pc.base_g + i10 * pc.nb_g[1] + i11 * pc.nb_g[2] + i12 * pc.nb_g[3];
                for (uint i0 = tid; i0 < pc.ne0; i0 += 256u) {
                    data_d[off_d + i0 * pc.nb_d[0]] += data_g[off_g + i0 * pc.nb_g[0]];
                }
            }
        }
        barrier();
    }
}
