#version 450
// train.cpp - Vulkan get_rows kernel（embedding 查表）
// 表 [ne0, n_vocab, ni1, ni2]，索引 [nr, ni1, ni2]（I32），输出 [ne0, nr, ni1, ni2]
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne0;
    uint n_vocab;
    uint nr;
    uint ni1;
    uint ni2;
    uint nb_t[4];
    uint nb_o[4];
    uint nb_i[3];
    uint base_t;
    uint base_o;
    uint base_i;
    uint numel;
} pc;

layout(std430, binding = 0) readonly buffer T { float data_t[]; };
layout(std430, binding = 1) readonly buffer I { int data_i[]; };
layout(std430, binding = 2) writeonly buffer O { float data_o[]; };
// 设备端错误标志：errors[0]=标志位、errors[1]=越界索引、errors[2]=算子码（1=get_rows）
layout(std430, binding = 3) buffer ERR { uint errors[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        const uint i0  = i % pc.ne0;
        uint       t   = i / pc.ne0;
        const uint i10 = t % pc.nr;
        t /= pc.nr;
        const uint i11 = t % pc.ni1;
        const uint i12 = t / pc.ni1;

        const int row = data_i[pc.base_i + i10 * pc.nb_i[0] + i11 * pc.nb_i[1] + i12 * pc.nb_i[2]];
        if (row < 0 || uint(row) >= pc.n_vocab) {
            // 索引越界：置错误标志（graph_compute 结束后由主机中止，与 CPU abort 语义一致）
            atomicOr(errors[0], 1u);
            errors[1] = uint(row);
            errors[2] = 1u;  // get_rows
        } else {
            const uint off_t = pc.base_t + uint(row) * pc.nb_t[1] + i11 * pc.nb_t[2] +
                               i12 * pc.nb_t[3] + i0 * pc.nb_t[0];
            const uint off_o = pc.base_o + i0 * pc.nb_o[0] + i10 * pc.nb_o[1] + i11 * pc.nb_o[2] +
                               i12 * pc.nb_o[3];
            data_o[off_o] = data_t[off_t];
        }

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
