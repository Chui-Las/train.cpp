#version 450
// train.cpp - Vulkan 跨步拷贝 kernel（cont/cpy/dup/pad/concat 共用；F32）
// 用 ne/nb（元素单位）寻址：每个线程拷一个元素；pad 只写源范围（目标其余区域由分配时清零）
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne[4];    // 拷贝范围（源形状）
    uint nb_a[4];  // 元素单位
    uint nb_d[4];
    uint base_a;
    uint base_d;
    uint numel;
} pc;

layout(std430, binding = 0) readonly buffer A { float data_a[]; };
layout(std430, binding = 1) writeonly buffer D { float data_d[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        uint idx[4];
        uint rem = i;
        for (int d = 0; d < 4; ++d) {
            idx[d] = rem % pc.ne[d];
            rem /= pc.ne[d];
        }
        uint off_a = pc.base_a;
        uint off_d = pc.base_d;
        for (int d = 0; d < 4; ++d) {
            off_a += idx[d] * pc.nb_a[d];
            off_d += idx[d] * pc.nb_d[d];
        }
        data_d[off_d] = data_a[off_a];

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
