#version 450
// train.cpp - Vulkan acc 累加 kernel（把 b 累加到目标的指定步长区域，用于视图反向）
// 无冲突：b 的元素按给定步长一一映射到目标区域
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne[4];    // b 形状
    uint nb_b[4];
    uint nb_d[4];  // 目标区域步长（元素单位；nb_d[0] 必为 1）
    uint base_b;
    uint base_d;   // 已含区域 offset
    uint numel;
} pc;

layout(std430, binding = 0) readonly buffer B { float data_b[]; };
layout(std430, binding = 1) buffer D { float data_d[]; };  // 需读写

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        uint idx[4];
        uint rem = i;
        for (int d = 0; d < 4; ++d) {
            idx[d] = rem % pc.ne[d];
            rem /= pc.ne[d];
        }
        uint off_b = pc.base_b;
        uint off_d = pc.base_d;
        for (int d = 0; d < 4; ++d) {
            off_b += idx[d] * pc.nb_b[d];
            off_d += idx[d] * pc.nb_d[d];
        }
        data_d[off_d] = data_d[off_d] + data_b[off_b];

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
