#version 450
// train.cpp - Vulkan pool_2d kernel（F32）
// 语义与 ggml_pool_2d / CPU compute_pool_2d 一致：
//   a=[W,H,C,N] -> dst=[OW,OH,C,N]，OW=(W+2*p0-k0)/s0+1、OH=(H+2*p1-k1)/s1+1（floor）
//   AVG 分母恒为 k0*k1（越界元素按 0 计入）；MAX 跳过越界元素（全越界输出 -FLT_MAX）
//   每个输出元素独立 gather，无需 atomic
// push constant 布局必须与 C++ 端 VulkanPool2DPC 一致（96 字节）
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    int  mode;
    int  k0;
    int  k1;
    int  s0;
    int  s1;
    int  p0;
    int  p1;
    uint OW;
    uint OH;
    uint C;
    uint N;
    uint W;
    uint H;
    uint nb_a[4];
    uint base_a;
    uint nb_d[4];
    uint base_d;
    uint numel;
} pc;

layout(std430, binding = 0) readonly buffer A { float data_a[]; };
layout(std430, binding = 1) writeonly buffer D { float data_d[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        const uint ow = i % pc.OW;
        const uint oh = (i / pc.OW) % pc.OH;
        const uint c  = (i / (pc.OW * pc.OH)) % pc.C;
        const uint n  = i / (pc.OW * pc.OH * pc.C);

        float acc  = 0.0;
        float best = -3.402823466e+38;
        for (int kh = 0; kh < pc.k1; ++kh) {
            const int ih = int(oh) * pc.s1 + kh - pc.p1;
            if (ih < 0 || ih >= int(pc.H)) {
                continue;
            }
            for (int kw = 0; kw < pc.k0; ++kw) {
                const int iw = int(ow) * pc.s0 + kw - pc.p0;
                if (iw < 0 || iw >= int(pc.W)) {
                    continue;
                }
                const uint off = pc.base_a + uint(iw) * pc.nb_a[0] + uint(ih) * pc.nb_a[1] +
                                 c * pc.nb_a[2] + n * pc.nb_a[3];
                const float v = data_a[off];
                if (pc.mode == 0) {
                    best = max(best, v);
                } else {
                    acc += v;
                }
            }
        }
        const float r = (pc.mode == 0) ? best : acc / float(pc.k0 * pc.k1);
        const uint  od = pc.base_d + ow * pc.nb_d[0] + oh * pc.nb_d[1] + c * pc.nb_d[2] +
                        n * pc.nb_d[3];
        data_d[od] = r;

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
