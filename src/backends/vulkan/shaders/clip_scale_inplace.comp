#version 450
// train.cpp - Vulkan 梯度就地裁剪缩放 kernel（M4.5；a *= min(1, max_norm/(sqrt(norm[0])+eps))）
// a 连续 F32（扁平索引）；binding 0 = node（a 的完整视图，就地读写），binding 1 = norm（1 元素）。
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint  numel;
    uint  base_a;
    uint  base_norm;
    float max_norm;
    float eps;
} pc;

layout(std430, binding = 0) buffer A { float data_a[]; };
layout(std430, binding = 1) readonly buffer N { float data_n[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    const float total = sqrt(data_n[pc.base_norm]);
    float scale = pc.max_norm / (total + pc.eps);
    if (scale > 1.0) {
        scale = 1.0;
    }
    uint i = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        data_a[pc.base_a + i] *= scale;
        if (pc.numel - i <= stride) {
            break;  // 无更多元素（避免 uint 回绕）
        }
        i += stride;
    }
}
