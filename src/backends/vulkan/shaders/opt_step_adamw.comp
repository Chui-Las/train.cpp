#version 450
// train.cpp - Vulkan 设备端 AdamW 优化器步（M4.1）
// 就地更新参数（binding 0 与 node 的 param 视图共享内存）；逐元素顺序与主机实现一致。
// 各张量为独立 descriptor，base_* 是各自 floor 对齐后的元素基址，必须分别加。
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne[4];
    uint nb[4];  // 元素单位步长
    uint base_p; // 相对各自 descriptor offset 的元素基址
    uint base_g;
    uint base_m;
    uint base_v;
    uint numel;
    float step_sz;   // lr / bc1
    float bc2_sqrt;  // sqrt(1 - beta2^t)
    float decay;     // 1 - lr*wd
    float beta1;
    float beta2;
    float eps;
} pc;

layout(std430, binding = 0) buffer P { float data_p[]; };        // 参数（读写）
layout(std430, binding = 1) readonly buffer G { float data_g[]; };
layout(std430, binding = 2) buffer M { float data_m[]; };
layout(std430, binding = 3) buffer V { float data_v[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        uint idx[4];
        uint rem = i;
        for (int d = 0; d < 4; ++d) {
            idx[d] = rem % pc.ne[d];
            rem /= pc.ne[d];
        }
        uint off_p = pc.base_p;
        uint off_g = pc.base_g;
        uint off_m = pc.base_m;
        uint off_v = pc.base_v;
        for (int d = 0; d < 4; ++d) {
            off_p += idx[d] * pc.nb[d];
            off_g += idx[d] * pc.nb[d];
            off_m += idx[d] * pc.nb[d];
            off_v += idx[d] * pc.nb[d];
        }
        const float g = data_g[off_g];
        float       m = data_m[off_m];
        float       v = data_v[off_v];
        m += (g - m) * (1.0 - pc.beta1);
        v = v * pc.beta2 + g * g * (1.0 - pc.beta2);
        data_m[off_m] = m;
        data_v[off_v] = v;

        const float p     = data_p[off_p] * pc.decay;
        const float denom = sqrt(v) / pc.bc2_sqrt + pc.eps;
        data_p[off_p]     = p - pc.step_sz * (m / denom);

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
