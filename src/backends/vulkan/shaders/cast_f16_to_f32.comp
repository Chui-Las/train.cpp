#version 450
// train.cpp - Vulkan 类型转换 F16 -> F32（16 位存储；IEEE half）
// 语义与 CPU/ggml 的 fp16_to_fp32 一致
// push constant 布局必须与 C++ 端 VulkanCastPC 一致（60 字节）
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint ne[4];
    uint nb_s[4];  // 元素单位步长（按源类型）
    uint nb_d[4];  // 元素单位步长（按目标类型）
    uint base_s;
    uint base_d;
    uint numel;
} pc;

layout(std430, binding = 0) readonly buffer S { uint16_t data_s[]; };
layout(std430, binding = 1) writeonly buffer D { float data_d[]; };

void main() {
    // 网格可能被限制（小上限设备）：按 gl_NumWorkGroups 跨步循环覆盖全部元素
    const uint stride = uint(gl_NumWorkGroups.x) * uint(gl_WorkGroupSize.x);
    uint       i      = gl_GlobalInvocationID.x;
    while (i < pc.numel) {
        uint idx[4];
        uint rem = i;
        for (int d = 0; d < 4; ++d) {
            idx[d] = rem % pc.ne[d];
            rem /= pc.ne[d];
        }
        uint off_s = pc.base_s;
        uint off_d = pc.base_d;
        for (int d = 0; d < 4; ++d) {
            off_s += idx[d] * pc.nb_s[d];
            off_d += idx[d] * pc.nb_d[d];
        }
        data_d[off_d] = unpackHalf2x16(uint(data_s[off_s])).x;

        if (pc.numel - i <= stride) {
            break;  // 无更多跨步元素（避免 uint 回绕）
        }
        i += stride;
    }
}
