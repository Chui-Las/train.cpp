#version 450
// train.cpp - Vulkan 行归约 kernel（sum_rows / mean；沿 ne0 归约，一行一个 workgroup）
// 行号 row = i1 + ne1*(i2 + ne2*i3)；输出偏移 = base_d + row
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint  mode;   // 0=sum, 1=mean
    uint  n_rows;
    uint  ne0;
    uint  ne1;
    uint  ne2;
    uint  nb_a[4];
    uint  base_a;
    uint  base_d;
    float inv_ne0;
} pc;

layout(std430, binding = 0) readonly buffer A { float data_a[]; };
layout(std430, binding = 1) writeonly buffer D { float data_d[]; };

shared float sdata[256];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    for (uint row = gl_WorkGroupID.x; row < pc.n_rows; row += gl_NumWorkGroups.x) {
        const uint i1 = row % pc.ne1;
        const uint t  = row / pc.ne1;
        const uint i2 = t % pc.ne2;
        const uint i3 = t / pc.ne2;
        const uint row_off = pc.base_a + i1 * pc.nb_a[1] + i2 * pc.nb_a[2] + i3 * pc.nb_a[3];

        float acc = 0.0;
        for (uint k = tid; k < pc.ne0; k += 256u) {
            acc += data_a[row_off + k * pc.nb_a[0]];
        }
        sdata[tid] = acc;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) {
            if (tid < s) {
                sdata[tid] += sdata[tid + s];
            }
            barrier();
        }
        if (tid == 0u) {
            data_d[pc.base_d + row] = (pc.mode == 1u) ? sdata[0] * pc.inv_ne0 : sdata[0];
        }
        barrier();
    }
}
